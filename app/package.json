{
  "name": "rustydagger",
  "private": true,
  "type": "module",
  "description": "Dragon Court, rebuilt as a local web app. See ../docs/roadmap.md.",
  "scripts": {
    "dev": "pnpm sync-content && vite",
    "build": "pnpm sync-content && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "sync-content": "cp ../content/*.json public/",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm check && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
